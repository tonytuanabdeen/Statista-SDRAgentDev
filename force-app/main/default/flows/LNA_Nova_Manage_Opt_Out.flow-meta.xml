    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Setting the Generated Lead Log Summary</description>
        <name>Set_Generated_Lead_Summary</name>
        <label>Set Generated Lead Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Generate_Lead_Description_Summary.structuredResponse.UpdatedSummary</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Respond_Classify_to_Negative_Replies</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Setting the Output Assignments</description>
        <name>Set_Output_Assignment</name>
        <label>Set Output Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varClassification</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Respond_Classify_to_Negative_Replies.structuredResponse.classification</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varEmailOutput</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Respond_Classify_to_Negative_Replies.structuredResponse.reply</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Apply_Classification</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Route to the correct record update based on the classification from the PT</description>
        <name>Apply_Classification</name>
        <label>Apply Classification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Unknown Classification</defaultConnectorLabel>
        <rules>
            <name>Classification_SPAM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClassification</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SPAM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unqualify_Spam</targetReference>
            </connector>
            <label>SPAM</label>
        </rules>
        <rules>
            <name>Classification_NOT_INTERESTED</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClassification</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NOT_INTERESTED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unqualify_Not_Interested</targetReference>
            </connector>
            <label>NOT_INTERESTED</label>
        </rules>
        <rules>
            <name>Classification_OPT_OUT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClassification</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OPT_OUT</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unqualify_Opt_Out</targetReference>
            </connector>
            <label>OPT_OUT</label>
        </rules>
    </decisions>
    <description>Orchestrates opt-out classification, response generation, and deterministic lead unqualification</description>
    <environments>Default</environments>
    <interviewLabel>LNA Nova - Manage Opt-Out {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LNA Nova - Manage Opt-Out</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetches the Lead record to read Country for locale resolution</description>
        <name>Get_Lead_Record</name>
        <label>Get Lead Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Generate_Lead_Description_Summary</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>InputLeadId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>Country</queriedFields>
        <queriedFields>LeadDescription__c</queriedFields>
        <queriedFields>Lead_Locale__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
