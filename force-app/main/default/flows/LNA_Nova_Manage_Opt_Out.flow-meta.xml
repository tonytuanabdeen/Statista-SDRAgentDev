        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>LNA_Nova_Negative_Response_Email</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Set_Output_Assignment</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:Current_Date</name>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Lead</name>
            <value>
