    <actionCalls>
        <description>Prompt template to generate outreach email content based on lead and identified persona</description>
        <name>Generate_Outreach_Email</name>
        <label>Generate Outreach Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>LNA_Nova_Outreach_Email</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Update_Lead_Status_to_Outreach</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:PersonaContent</name>
            <value>
                <elementReference>varPersonaContent</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Recipient</name>
            <value>
                <elementReference>Get_Lead_Record</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:ICPArticle</name>
            <value>
                <elementReference>varICPArticleSolution</elementReference>
            </value>
        </inputParameters>
        <nameSegment>LNA_Nova_Outreach_Email</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>varEmailBody</assignToReference>
            <name>promptResponse</name>
        </outputParameters>
