    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assign variable to append all retrieved personas from knowledge articles</description>
        <name>All_Personas</name>
        <label>All Personas</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAllPersonas</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Persona_Profiles.Solution__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Persona_Profiles</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Store ICP Article Solution knowledge article into variable</description>
        <name>Assign_ICP_Manufacturing_Solution</name>
        <label>Assign ICP Manufacturing Solution</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varICPArticleSolution</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Industry.Solution__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Generate_Outreach_Email</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Store ICP Article Solution knowledge article into variable</description>
        <name>Assign_ICP_Telco_IT_Solution</name>
        <label>Assign ICP Telco &amp; IT Solution</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varICPArticleSolution</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Telco_IT_Industry.Solution__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Generate_Outreach_Email</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Store persona content from knowledge article into variable</description>
        <name>Assign_Persona_Content</name>
        <label>Assign Persona Content</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPersonaContent</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Detected_Persona.Solution__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Lead_s_Industry</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Store fallback as persona into variable</description>
        <name>Assign_Persona_Fallback_Content</name>
        <label>Assign Persona Fallback Content</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPersonaContent</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>FALLBACK</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Lead_s_Industry</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check Lead&apos;s Industry</description>
        <name>Lead_s_Industry</name>
        <label>Lead&apos;s Industry</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_Industry</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Blank Industry</defaultConnectorLabel>
        <rules>
            <name>Manufacturing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Record.Industry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MANUFACTURING</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Industry</targetReference>
            </connector>
            <label>Manufacturing</label>
        </rules>
        <rules>
            <name>Telco_IT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Record.Industry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOMMUNICATION___IT</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Telco_IT_Industry</targetReference>
            </connector>
            <label>Telco &amp; IT</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Lead title is provided</description>
        <name>Lead_Title_Provided</name>
        <label>Lead Title Provided</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Persona_Fallback_Content</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Title - Use Fallback Persona</defaultConnectorLabel>
        <rules>
            <name>Title_provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Record.Title</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lead_Personas</targetReference>
            </connector>
            <label>Title provided</label>
        </rules>
    </decisions>
    <decisions>
        <description>Skip persona detail retrieval if fallback has been identified</description>
        <name>Skip_if_Persona_Fallback</name>
        <label>Skip if Persona Fallback</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Persona_Fallback_Content</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Persona Matched</defaultConnectorLabel>
        <rules>
            <name>Persona_Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Detect_Lead_Persona.promptResponse</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>FALLBACK</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Detected_Persona</targetReference>
            </connector>
            <label>Persona Matched</label>
        </rules>
    </decisions>
    <description>Flow that handles the orchestration of the initial outreach email generation for LNA Nova</description>
    <environments>Default</environments>
    <interviewLabel>LNA Nova - Initial Outreach {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LNA Nova - Initial Outreach</label>
    <loops>
        <name>Loop_Persona_Profiles</name>
        <label>Loop Persona Profiles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Lead_Personas</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>All_Personas</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Detect_Lead_Persona</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the detected persona details from knowledge articles</description>
        <name>Get_Detected_Persona</name>
        <label>Get Detected Persona</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Persona_Content</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Title</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Detect_Lead_Persona.promptResponse</elementReference>
            </value>
        </filters>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Knowledge__kav</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
